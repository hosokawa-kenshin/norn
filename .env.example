LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional local-only character profile (excluded from Git)
# NORN_CHARACTER_PATH=characters/active.json

# Google Calendar OAuth (optional; create a Desktop app OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NORN_API_PORT=8000
NORN_GOOGLE_CALENDAR_ID=primary

STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
MAX_AUDIO_MB=20

# Optional Japanese TTS. No engine/model is assumed or downloaded automatically.
# Use paths as seen by the backend OS. Relative paths are based on the NORN root.
NORN_TTS_ENABLED=0
# NORN_TTS_MODEL=/path/to/voice/model.safetensors
# Python defaults to ROOT/.venv/bin/python or ROOT/.venv/Scripts/python.exe.
# NORN_TTS_PYTHON=/path/to/tts-environment/python
# Optional local Japanese BERT/tokenizer directory; otherwise use engine defaults.
# NORN_TTS_BERT_MODEL=/path/to/japanese-bert
NORN_TTS_DEVICE=auto
NORN_TTS_SPEAKER_ID=0
NORN_TTS_STYLE=Neutral

# Optional local data path. Defaults to ./data/norn.sqlite3
# NORN_DATA_DIR=./data

# Task scheduling defaults: weekdays 09:00-18:00 (0=Monday, 6=Sunday)
NORN_PLANNING_DAY_START=09:00
NORN_PLANNING_DAY_END=18:00
NORN_PLANNING_WORKDAYS=0,1,2,3,4