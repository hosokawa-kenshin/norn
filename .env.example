LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional local-only character profile (excluded from Git)
# NORN_CHARACTER_PATH=characters/active.json

# Google Calendar OAuth (optional; create a Desktop app OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NORN_API_PORT=8000
NORN_GOOGLE_CALENDAR_ID=primary

STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
MAX_AUDIO_MB=20

# Persistent GPU speech worker (separate Style-Bert-VITS2 environment)
NORN_TTS_ENABLED=1
# NORN_TTS_ROOT=/home/your-user/voice_project/style-bert-vits2
# NORN_TTS_MODEL=/absolute/path/to/norn_voice_e100_s26100.safetensors

# Optional local data path. Defaults to ./data/norn.sqlite3
# NORN_DATA_DIR=./data

# Task scheduling defaults: weekdays 09:00-18:00 (0=Monday, 6=Sunday)
NORN_PLANNING_DAY_START=09:00
NORN_PLANNING_DAY_END=18:00
NORN_PLANNING_WORKDAYS=0,1,2,3,4